{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "framework": null,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/((?!sw\\.js).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/llms-full.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ],
  "redirects": [
    { "source": "/blog", "destination": "/blog/th/", "permanent": true },
    { "source": "/blog/", "destination": "/blog/th/", "permanent": true },
    { "source": "/th", "destination": "/landing/", "statusCode": 301 },
    { "source": "/th/", "destination": "/landing/", "statusCode": 301 },
    { "source": "/en", "destination": "/landing-en/", "statusCode": 301 },
    { "source": "/en/", "destination": "/landing-en/", "statusCode": 301 },
    { "source": "/zh", "destination": "/landing-zh/", "statusCode": 301 },
    { "source": "/zh/", "destination": "/landing-zh/", "statusCode": 301 },
    { "source": "/feed.xml", "destination": "/blog/th/feed.xml", "statusCode": 301 },
    { "source": "/rss.xml", "destination": "/blog/th/feed.xml", "statusCode": 301 },
    { "source": "/atom.xml", "destination": "/blog/th/feed.xml", "statusCode": 301 },
    { "source": "/blog/:lang/:file.html/", "destination": "/blog/:lang/:file.html", "statusCode": 301 },
    { "source": "/songs/:lang/:file.html/", "destination": "/songs/:lang/:file.html", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/sitemap-blog.xml", "destination": "/api/blog-sitemap" },
    { "source": "/ads.txt", "destination": "/api/plain-404" },
    { "source": "/indexnow-key.txt", "destination": "/api/plain-404" },
    { "source": "/blog/:lang/", "destination": "/api/blog-page?lang=:lang" },
    { "source": "/blog/:lang/:rest*", "destination": "/api/blog-page?lang=:lang&rest=:rest*" },
    { "source": "/blog/:slug", "destination": "/api/blog-page?slug=:slug" },
    { "source": "/((?!sw\\.js|manifest\\.webmanifest|icon\\.svg|updates/|api/|llms\\.txt$|llms-full\\.txt$|humans\\.txt$|8f3c1a9e6b274d05a1c8e7f04b2d6a91\\.txt$|sitemap-blog\\.xml$).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/blog-page.js": { "includeFiles": "supabase-client.ts" },
    "api/blog-sitemap.js": { "includeFiles": "supabase-client.ts" }
  }
}
