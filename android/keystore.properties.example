# ── TIGA.AI — Android production release signing ──────────────────────────────
# Copy this file to android/keystore.properties (it is gitignored — NEVER
# commit the real key or its passwords) and fill in your real values.
#
# Generate the key ONCE, then back it up somewhere safe (cloud storage + USB).
# Losing this keystore means you can never update the Play Store app again —
# Play's app-signing key is separate, but the upload key below is what signs
# every AAB you upload.
#
#   keytool -genkey -v -keystore app/tiga-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias tiga-release
#
# storeFile is relative to android/app/ (the app module), so the command above
# places tiga-release.jks right next to debug.keystore. Full steps + the rest
# of the Play Store checklist: see PLAY_STORE_GUIDE.md at the repo root.

storeFile=tiga-release.jks
storePassword=CHANGE_ME
keyAlias=tiga-release
keyPassword=CHANGE_ME
