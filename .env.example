# .env.example — every build-time variable the app reads. Copy to .env.local for local work; on Vercel set them in Project > Settings > Environment Variables.
# Nothing here is a secret: VITE_* values are compiled into the public bundle. NEVER put a service-role key, a Stripe secret or a LINE channel SECRET here (the LINE channel secret goes only into the Supabase Dashboard).
# An empty / missing value is the safe default: the feature it controls stays off.

# Android build only (native-updater.ts): "false" builds the Google Play flavour (no self-update, no in-app sales). Leave unset for the web / OTA build.
VITE_OTA_ENABLED=

# LINE Official Account add-friend link, e.g. https://lin.ee/xxxxxxx . Used by every "add us on LINE" button (the song result, the level quiz). Empty = those buttons are not drawn.
VITE_LINE_OA_URL=

# LINE Login (Step 2.2). Set to 1 ONLY after the custom provider exists in the Supabase Dashboard and the LINE Login channel is published; any other value keeps the LINE button hidden everywhere.
VITE_LINE_LOGIN_ENABLED=
# The identifier of that custom OAuth provider in Supabase (it must start with "custom:"). Default: custom:line
VITE_LINE_PROVIDER_ID=custom:line

# Conversion tracking (Step 2.3). Empty = the pixel script is never loaded. Loaded only after the visitor accepts marketing cookies.
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
