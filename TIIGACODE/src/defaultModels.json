{
  "defaultModel": "claude",
  "providers": {
    "anthropic": {
      "kind": "anthropic",
      "baseUrl": "https://api.anthropic.com",
      "apiKeyEnv": "ANTHROPIC_API_KEY"
    },
    "openai": {
      "kind": "openai-compatible",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY"
    },
    "glm": {
      "kind": "openai-compatible",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKeyEnv": "ZHIPU_API_KEY"
    },
    "qwen": {
      "kind": "openai-compatible",
      "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "apiKeyEnv": "DASHSCOPE_API_KEY"
    },
    "kimi": {
      "kind": "openai-compatible",
      "baseUrl": "https://api.moonshot.cn/v1",
      "apiKeyEnv": "MOONSHOT_API_KEY"
    },
    "mimo": {
      "kind": "openai-compatible",
      "baseUrl": "",
      "apiKeyEnv": "MIMO_API_KEY",
      "baseUrlEnv": "MIMO_BASE_URL"
    }
  },
  "models": [
    { "id": "claude", "provider": "anthropic", "model": "claude-sonnet-5", "label": "Claude Sonnet 5 (Anthropic)" },
    { "id": "claude-opus", "provider": "anthropic", "model": "claude-opus-5", "label": "Claude Opus 5 (Anthropic)" },
    { "id": "chatgpt", "provider": "openai", "model": "gpt-5", "label": "ChatGPT / GPT-5 (OpenAI)" },
    { "id": "glm-5.2", "provider": "glm", "model": "glm-5.2", "label": "GLM-5.2 (Zhipu)" },
    { "id": "glm-5.3", "provider": "glm", "model": "glm-5.3", "label": "GLM-5.3 (Zhipu)" },
    { "id": "qwen-3.8-max", "provider": "qwen", "model": "qwen3.8-max", "label": "Qwen3.8-Max (Alibaba)" },
    { "id": "qwen-3.7", "provider": "qwen", "model": "qwen3.7", "label": "Qwen 3.7 (Alibaba)" },
    { "id": "kimi-k3", "provider": "kimi", "model": "kimi-k3", "label": "Kimi K3 (Moonshot)" },
    { "id": "mimo-2.5", "provider": "mimo", "model": "mimo-2.5", "label": "Xiaomi MiMo 2.5" }
  ]
}
