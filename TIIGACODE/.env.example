# ---------------------------------------------------------------------------
# TIIGACODE — คีย์ API ของแต่ละผู้ให้บริการ
# คัดลอกไฟล์นี้เป็น .env ในโฟลเดอร์เดียวกัน (TIIGACODE/.env) แล้วใส่คีย์เฉพาะ
# ผู้ให้บริการที่ตั้งใจจะใช้จริง — ไม่จำเป็นต้องใส่ครบทุกตัว
# ---------------------------------------------------------------------------

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Zhipu AI GLM (open.bigmodel.cn) — https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# Alibaba Cloud Qwen / DashScope compatible-mode — https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# Moonshot AI Kimi — https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# Xiaomi MiMo — ยังไม่มี public hosted API อย่างเป็นทางการเทียบเท่ารายอื่น
# (ส่วนใหญ่เผยแพร่เป็น open-weight model) ถ้า self-host เอง (เช่นผ่าน vLLM/SGLang)
# หรือใช้ผู้ให้บริการ inference ที่ host ให้ ให้ใส่ base URL ที่นี่ด้วย
MIMO_API_KEY=
MIMO_BASE_URL=
